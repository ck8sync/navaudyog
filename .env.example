# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (public anon key only – never put the service-role key in NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL used for links inside e-mails
APP_URL=http://localhost:3000

# SMTP settings for Nodemailer (application status e-mails). Server-only.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character Google App Password>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Nava Udyog
MAIL_FROM_EMAIL=you@example.com

